<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A second process for the SQLite tests: Unified.Data.Tables.Tests starts this program to write to a
    database file the test process has open as well (two writers on one file), and to be killed in the
    middle of a loop of commits. Not a test project and never packed.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Started with whatever runtime the test run has: the tests also run on newer ones. -->
    <RollForward>LatestMajor</RollForward>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1515;CA2007;CA1852</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Unified.Data.Tables.Sqlite\Unified.Data.Tables.Sqlite.csproj" />
  </ItemGroup>

</Project>
