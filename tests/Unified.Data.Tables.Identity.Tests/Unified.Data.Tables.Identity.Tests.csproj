<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Run on every supported runtime, as Unified.Data.Tables.Tests does. -->
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Same analyzer allowances the sibling test project makes; see its comment. -->
    <NoWarn>$(NoWarn);CA1000;CA1707;CA2000;CA2007;CA5394;CA1515;CA1861;CA1819;CA1852;CA1034;CA1024;xUnit1051;xUnit2032</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Unified.Data.Tables.Identity\Unified.Data.Tables.Identity.csproj" />
    <ProjectReference Include="..\..\src\Unified.Data.Tables.InMemory\Unified.Data.Tables.InMemory.csproj" />
    <!-- The same suite runs on the SQLite provider (see SqliteIdentityTests.cs) and on the Azure provider
         over Azurite (see AzuriteIdentityTests.cs). Only the tests reference the providers: the Identity
         package itself depends on the abstractions alone. -->
    <ProjectReference Include="..\..\src\Unified.Data.Tables.Sqlite\Unified.Data.Tables.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\Unified.Data.Tables\Unified.Data.Tables.csproj" />
  </ItemGroup>

  <!-- The Azurite probe and connection string of the sibling test project, shared rather than copied, so
       both suites find the emulator, skip and fail by the same rules. -->
  <ItemGroup>
    <Compile Include="..\Unified.Data.Tables.Tests\TestSupport\AzuriteConnection.cs" Link="TestSupport\AzuriteConnection.cs" />
    <Compile Include="..\Unified.Data.Tables.Tests\TestSupport\AzuriteProbe.cs" Link="TestSupport\AzuriteProbe.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
