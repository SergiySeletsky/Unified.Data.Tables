<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The packages target net10.0, but a consumer may run them on a newer runtime, whose behaviour can
         differ (.NET 11 made double-to-decimal conversion exact): run the tests on every supported one. -->
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!--
      Analyzer noise that is idiomatic in test code: underscore method names (CA1707), no
      ConfigureAwait (CA2007), non-crypto Random in fixtures (CA5394), public test types (CA1515),
      constant array args (CA1861), array-returning props on test models (CA1819), unsealed test
      helpers (CA1852), and the xUnit cancellation-token analyzers.
    -->
    <NoWarn>$(NoWarn);CA1000;CA1707;CA2000;CA2007;CA5394;CA1515;CA1861;CA1819;CA1852;CA1034;CA1024;xUnit1051;xUnit2032</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <!-- The compiler as a library: the upgrade analyzer is run over small samples (see Analyzers/). The
         version the analyzer itself is built against. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Unified.Data.Tables\Unified.Data.Tables.csproj" />
    <ProjectReference Include="..\..\src\Unified.Data.Tables.InMemory\Unified.Data.Tables.InMemory.csproj" />
    <ProjectReference Include="..\..\src\Unified.Data.Tables.Sqlite\Unified.Data.Tables.Sqlite.csproj" />
    <!-- The second process of the SQLite multi-process tests (see Sqlite/SqliteMultiProcessTests.cs): built
         and copied beside the tests, which start it with the dotnet host. -->
    <ProjectReference Include="..\Unified.Data.Tables.Sqlite.TestHelper\Unified.Data.Tables.Sqlite.TestHelper.csproj" />
    <!-- The conformance kit and its xUnit adapter, run here against every provider (see Conformance/). -->
    <ProjectReference Include="..\..\src\Unified.Data.Tables.Conformance\Unified.Data.Tables.Conformance.csproj" />
    <ProjectReference Include="..\..\src\Unified.Data.Tables.Conformance.Xunit\Unified.Data.Tables.Conformance.Xunit.csproj" />
    <!-- The optional upgrade analyzer, referenced as a library so the tests can run it; it is not applied
         to this project's own code. -->
    <ProjectReference Include="..\..\src\Unified.Data.Tables.Analyzers\Unified.Data.Tables.Analyzers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The golden corpus: what 0.9.2 puts on the wire, asserted verbatim (see Golden/GoldenFile.cs). -->
    <None Include="Golden\Data\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
