<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- AOT and trimming contract: the package is analyzed and packed as AOT-compatible. netstandard2.0 has no analyzer. -->
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
    <PackageId>Unified.Data.Tables.InMemory</PackageId>
    <RootNamespace>Unified.Data.Tables.InMemory</RootNamespace>
    <AssemblyName>Unified.Data.Tables.InMemory</AssemblyName>
    <Description>Faithful in-memory IStorage&lt;T&gt; for Unified.Data.Tables: rows round-trip through the real TableEntitySerializer (so tests exercise production serialization behavior — decimal-as-double, enum-as-string, nested flattening, oversized cells, lossless [TableValueSplit] large values with an in-memory blob store for offload), with the service's semantics through the provider-neutral exceptions TableStorage&lt;T&gt; throws (DuplicateKeyException on a duplicate create, ConcurrencyConflictException on an ETag conflict, EntityNotFoundException for a missing row), the service's status and error code kept as the InnerException, per-transaction batches, QueryOptions.Select projection, and identical id normalization and key splitting. For unit tests, dev mode, and offline runtime.</Description>
    <PackageTags>azure;table-storage;repository;in-memory;testing;fake;storage;nosql</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <!-- Binds to the core package's hidden provider SPI (Unified.Data.Tables.Providers) and internals, and to the abstractions' internals, which may change in any minor version: depend on exactly the same version. See Directory.Build.targets. -->
    <PackExactProjectReferenceVersions>true</PackExactProjectReferenceVersions>
  </PropertyGroup>

  <!-- The core, not the Azure provider: the fake stores the same rows through the same serializer, with
       no Azure.Storage.Blobs and no Azure provider package in its closure. -->
  <ItemGroup>
    <ProjectReference Include="..\Unified.Data.Tables.Abstractions\Unified.Data.Tables.Abstractions.csproj" />
    <ProjectReference Include="..\Unified.Data.Tables.Core\Unified.Data.Tables.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
  </ItemGroup>

  <!-- InMemoryOffloadBlobStore's Seed/Tamper/Remove/Names let the tests stage blob states directly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Unified.Data.Tables.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
