<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Unified.Data.Tables.Identity</PackageId>
    <RootNamespace>Unified.Data.Tables.Identity</RootNamespace>
    <AssemblyName>Unified.Data.Tables.Identity</AssemblyName>
    <Description>ASP.NET Core Identity stores persisted through Unified.Data.Tables' IStorage&lt;T&gt;: seven Entity-derived row models (one table each), deterministic key composition, and IUserStore/IRoleStore implementations covering passwords, external logins, claims, roles, tokens, 2FA and lockout. Depends only on the abstractions, so it runs against Azure Table Storage, the in-memory provider, or any other IStorage&lt;T&gt; — your whole Identity stack is unit-testable with no emulator.</Description>
    <PackageTags>azure;table-storage;aspnetcore;identity;authentication;userstore;rolestore;storage;nosql</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Identity.Stores" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Unified.Data.Tables.Abstractions\Unified.Data.Tables.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
